# ============================================================
#  Tap DAO — environment (self-hosted, Cloudflare Tunnel)
# ============================================================
#  This template ships WORKING DEMO VALUES, so the stack starts with no setup:
#      cp .env.example .env && docker compose up -d --build
#
#  docker compose reads .env automatically. The same values are also the
#  defaults inside docker-compose.yml, so the stack still starts if .env is
#  missing — this file is for overriding them without editing Compose.
#
#  Only two hostnames are public:
#      https://tap.kiyoai.in       React frontend
#      https://tap-back.kiyoai.in  Node.js backend / API
# ============================================================

# ── Public origins ────────────────────────────────────────────────────────
# The UI origin. It is the CORS allow-list for credentialed API calls and the
# base for invite links / QR codes.
PUBLIC_APP_URL=https://tap.kiyoai.in
# The API origin the browser calls directly (fetch + Socket.IO).
PUBLIC_API_URL=https://tap-back.kiyoai.in

# ── Published ports (host side) ────────────────────────────────────────────
# These are bound to 127.0.0.1 only: the host's cloudflared reaches them,
# nothing else can. Do not change to a public interface.
FRONTEND_PORT=9100
BACKEND_PORT=9200

# ── Reverse proxy ──────────────────────────────────────────────────────────
# 1 = trust X-Forwarded-* from the Cloudflare Tunnel (required for Secure
# cookies to be issued over HTTPS). 0 disables it; loopback trusts the local
# address only.
TRUST_PROXY=1
# auto adds the Secure cookie flag when the forwarded protocol is https.
COOKIE_SECURE=auto
# none is required: the UI and the API are different origins, so the session
# cookie is cross-site. Browsers only accept SameSite=None with Secure.
# Use lax only when the API is served from the same origin as the UI.
SESSION_COOKIE_SAME_SITE=none

# ── Secrets ────────────────────────────────────────────────────────────────
# DEMO values below: they work out of the box but they are published in this
# repo, so generate your own before exposing a real deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs the session cookie. Changing it logs every member out.
SESSION_SECRET=98439fe9c1680d6c2f0eddcece833b39e11e696ca20d37dfa33384a8b1200d32
# Shared transport key for the API payload envelope. It must be identical in
# the frontend build (VITE_CRYPTO_SECRET_KEY below). Note that this key ships
# inside the browser bundle by design — member wallet keys are never protected
# by it, they are sealed with the member's own PIN (PBKDF2 + AES-256-GCM).
CRYPTO_SECRET_KEY=8e18648a20e5d3e0e6710f8a24516e3745cc54ffb72b384b25e7760cdb4bc7ff

# ── Sessions ──────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=tapdao_sid
SESSION_IDLE_TTL_MS=1800000
SESSION_ABSOLUTE_TTL_MS=43200000

# ── Frontend build-time variables (inlined by Vite) ────────────────────────
# Defaults to PUBLIC_API_URL in docker-compose.yml; set them here only to
# override the public API origin.
# VITE_API_URL=https://tap-back.kiyoai.in
# VITE_SOCKET_URL=https://tap-back.kiyoai.in
VITE_AI_TIMEOUT_MS=100000
# Dev-server only: where the Vite proxy forwards /api and /socket.io.
VITE_PROXY_TARGET=http://app:9200

# ── Uploads ───────────────────────────────────────────────────────────────
# 5 MB, matching the backend upload limit.
MAX_UPLOAD_BYTES=5242880

# ── AI Assist (optional, server-side only) ────────────────────────────────
# Public URL printed by colab/tap_dao_ai_server.py running in Google Colab.
# Leave empty to disable AI Assist.
COLAB_AI_URL=
AI_GENERATE_TIMEOUT_MS=90000
AI_SUMMARIZE_TIMEOUT_MS=60000
AI_HEALTH_TIMEOUT_MS=8000

# ── Cloudflare Tunnel (optional) ──────────────────────────────────────────
# Named tunnel that maps the two public hostnames onto the loopback ports:
#   https://tap.kiyoai.in      → http://localhost:9100   (frontend)
#   https://tap-back.kiyoai.in → http://localhost:9200   (backend)
# See cloudflare/README.md and cloudflare/tunnel-config.example.yml.
CLOUDFLARE_TUNNEL_NAME=tapdao
