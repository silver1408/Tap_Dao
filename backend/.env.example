# ============================================================
#  Tap DAO — Backend environment template
# ============================================================
#  The production deployment is configured through the *root* .env file
#  (see ../.env.example) because docker-compose.yml passes these values into
#  the container. Use this file when running `node server.js` directly on the
#  host.
#
#  Copy to .env and fill in the real values. .env is gitignored — never commit.
#
#  Production public origins:
#      UI  https://tap.kiyoai.in
#      API https://tap-back.kiyoai.in
# ============================================================

# ── Server ───────────────────────────────────────────────────────────────
# 9200 is what the Cloudflare tunnel and the Compose stack publish.
PORT=9200

# Local EVM node. Inside Docker this is the Compose service name
# (http://hardhat:8545); on a bare-metal host it is the local node.
RPC_URL=http://127.0.0.1:8545
ADDRESS_FILE=./address.json

# Where persistent state is written (NFC cards, wallet slots, proposal
# images, invite codes, sessions). Keep this on a Docker volume.
DATA_DIR=./runtime
# Where uploaded proposal images are written. Keep this on a persistent volume.
UPLOAD_DIR=./uploads

# ── Public origins ───────────────────────────────────────────────────────
# The UI origin. Sole entry of the CORS allow-list for credentialed requests,
# and the base for invite links / QR codes.
PUBLIC_APP_URL=https://tap.kiyoai.in
# The public API origin, reported by /tunnel-info.
PUBLIC_API_URL=https://tap-back.kiyoai.in
# Comma-separated allow-list. Defaults to PUBLIC_APP_URL when empty; an empty
# value combined with an empty PUBLIC_APP_URL reflects any origin, which is
# only acceptable for local development.
CORS_ALLOWED_ORIGINS=https://tap.kiyoai.in
# 1 = trust X-Forwarded-* from the Cloudflare Tunnel (needed for Secure
# cookies over HTTPS). 0 = disabled, loopback = trust local addresses only.
TRUST_PROXY=1

# ── Transport encryption (must match VITE_CRYPTO_SECRET_KEY) ─────────────
# Shared key for the API payload envelope. The value below is the DEMO default
# (identical in .env.example, both docker-compose.yml files and the frontend
# template); generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This key ships in the browser bundle by design; wallet keys are sealed with
# the member's PIN, not with this value.
CRYPTO_SECRET_KEY=8e18648a20e5d3e0e6710f8a24516e3745cc54ffb72b384b25e7760cdb4bc7ff

# ── Sessions ─────────────────────────────────────────────────────────────
# Signs the session cookie. DEMO default below; generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sessions do not survive a restart when this is unset.
SESSION_SECRET=98439fe9c1680d6c2f0eddcece833b39e11e696ca20d37dfa33384a8b1200d32
SESSION_COOKIE_NAME=tapdao_sid
# Sliding idle window (default 30 min) and hard session cap (default 12 h)
SESSION_IDLE_TTL_MS=1800000
SESSION_ABSOLUTE_TTL_MS=43200000
# The UI (tap.kiyoai.in) and this API (tap-back.kiyoai.in) are different
# origins, so the cookie is cross-site: `none` is required. Browsers only
# accept SameSite=None together with Secure. Use `lax` only for a same-origin
# deployment.
SESSION_COOKIE_SAME_SITE=none
# auto | true | false — "auto" adds the Secure flag when the forwarded
# protocol is https (i.e. behind the Cloudflare Tunnel).
COOKIE_SECURE=auto

# ── Wallets (optional) ───────────────────────────────────────────────────
# Defaults to the well-known public Hardhat development keys.
# Set real keys for any non-demo deployment.
ADMIN_PRIVATE_KEY=
VOTER_PRIVATE_KEYS=

# ── Uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=5242880

# ── AI / LLM (Google Colab — free) ───────────────────────────────────────
# Run colab/tap_dao_ai_server.py in Google Colab (Runtime → T4 GPU).
# The notebook prints a public URL; paste it below. Leave empty to disable.
COLAB_AI_URL=
# Per-request budgets (ms) — Colab CPU runs can be slow on first inference
AI_GENERATE_TIMEOUT_MS=90000
AI_SUMMARIZE_TIMEOUT_MS=60000
AI_HEALTH_TIMEOUT_MS=8000

# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────
# Log file scanned for a quick-tunnel URL so /tunnel-info can report it.
# Unused when PUBLIC_APP_URL / PUBLIC_API_URL are set.
CLOUDFLARED_LOG=
