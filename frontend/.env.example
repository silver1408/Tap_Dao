# ============================================================
#  Tap DAO — Frontend environment template
# ============================================================
#  Vite inlines VITE_* variables into the bundle at BUILD time, so these are
#  passed as build args in docker-compose.yml (see ../.env.example). This file
#  is only needed when building the bundle by hand:
#
#      cp .env.example .env
#      npm run build
#
#  .env is gitignored — never commit.
# ============================================================

# ── Public origins ────────────────────────────────────────────────────────
# The public API the browser calls. The UI itself is served from
# https://tap.kiyoai.in, so this is a different origin on purpose: the backend
# owns CORS, the session cookie and the WebSocket handshake.
VITE_API_URL=https://tap-back.kiyoai.in
# Socket.IO endpoint. Same host as the API unless separated.
VITE_SOCKET_URL=https://tap-back.kiyoai.in

# ── Transport encryption ──────────────────────────────────────────────────
# Must match CRYPTO_SECRET_KEY in the backend environment. The DEMO default
# below is the same value used by .env.example and both docker-compose.yml files.
VITE_CRYPTO_SECRET_KEY=8e18648a20e5d3e0e6710f8a24516e3745cc54ffb72b384b25e7760cdb4bc7ff

# ── Timeouts ──────────────────────────────────────────────────────────────
# AI Assist request budget (ms). Colab runtimes wake slowly.
VITE_AI_TIMEOUT_MS=100000

# ── Dev server only ───────────────────────────────────────────────────────
# Where `npm run dev` proxies /api and /socket.io. Inside Docker this is the
# backend service name. Not used by the production build.
VITE_PROXY_TARGET=http://app:9200
# Hosts the dev server answers to (comma separated).
VITE_ALLOWED_HOSTS=tap.kiyoai.in,tap-back.kiyoai.in,localhost,127.0.0.1
